{
  "manifest_version":3,
  "name":"Free AI Browser Bridge",
  "version":"0.3.0",
  "description":"Connects your Chromium tabs and supported AI provider chats to the Free AI desktop app.",
  "permissions":["tabs","scripting","storage"],
  "host_permissions":["<all_urls>"],
  "background":{"service_worker":"background.js"},
  "content_scripts":[{
    "matches":[
      "http://*/*",
      "https://*/*"
    ],
    "js":["content.js"],
    "run_at":"document_idle"
  }],
  "action":{"default_title":"Free AI Browser Bridge"}
}